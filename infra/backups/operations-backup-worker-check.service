[Unit]
Description=Validate Bombo backup worker configuration without connecting to services

[Service]
Type=oneshot
User=bombo
Group=bombo
UMask=0077
WorkingDirectory=/opt/bombo/current
Environment=NODE_ENV=production
Environment=BACKUP_ROOT=/var/lib/bombo/backups
Environment=PRIVATE_OBJECT_ROOT=/var/lib/bombo/private-objects
Environment=PRIVATE_OBJECT_PROVIDER=local
Environment=PG_BIN=/usr/lib/postgresql/18/bin
EnvironmentFile=/etc/bombo/backup-worker.env
ExecStart=/usr/bin/node /opt/bombo/current/scripts/operations-backup-worker.mjs --dry-run
NoNewPrivileges=yes
PrivateDevices=yes
PrivateNetwork=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
LockPersonality=yes
RestrictSUIDSGID=yes
StandardOutput=journal
StandardError=journal
SyslogIdentifier=bombo-backup-check
