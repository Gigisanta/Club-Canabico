PORT=3001
VITE_PORT=5173
HOST=127.0.0.1
NODE_ENV=development
DEMO_MODE=false
# Required to open the public API outside local development.
PUBLIC_SITE_APPROVED=false
# Local preview works only in development when HOST is a loopback address.
PUBLIC_SITE_PREVIEW=true
# Cambiar solo después de la validación legal documentada por el profesional del club.
CLUB_OPERATIONS_APPROVED=false
POSTGRES_PASSWORD=
DATABASE_URL=
JWT_SECRET=replace-with-at-least-32-random-characters
# Optional stable dedicated HMAC key for imported member IDs. If omitted, JWT_SECRET is used.
# Preserve this key across deployments; rotating it changes pseudonymous IDs.
DATA_IMPORT_PII_SECRET=
ALLOWED_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
ADMIN_NAME=Administrador
# Opcional: solo para crear un administrador de recuperación al sembrar la base real.
ADMIN_EMAIL=
# Completar junto con ADMIN_EMAIL; mínimo 12 caracteres.
ADMIN_PASSWORD=
# URL privada donde se abrirán los enlaces de activación. Debe usar HTTPS fuera de localhost.
APP_ORIGIN=
# Activar detrás de HTTPS en producción.
COOKIE_SECURE=false
# Pruebas: base PostgreSQL local dedicada, distinta de DATABASE_URL y con nombre bombo_ui_*.
# Los runners crean y eliminan esquemas temporales; nunca apuntar a un túnel hacia otra base.
# TEST_DATABASE_URL=postgresql://usuario:clave@127.0.0.1:5432/bombo_ui_pruebas
# Restauración de ensayo: ruta local absoluta, vacía y separada del almacenamiento normal y del backup.
RESTORE_PRIVATE_OBJECT_ROOT=
# Producción Vercel: usar PostgreSQL con pooler, en la misma región que la función.
# DATABASE_URL se obtiene del proveedor y se guarda sólo como variable privada.
# Los pools de producción usan como máximo cuatro conexiones por instancia.
# Almacenamiento privado: vercel-blob o S3; nunca publicar el bucket de documentos.
PRIVATE_OBJECT_PROVIDER=
BLOB_READ_WRITE_TOKEN=
PRIVATE_S3_BUCKET=
PRIVATE_S3_REGION=
PRIVATE_S3_ENDPOINT=
# Vercel usa outbox durable al terminar comandos; el cron actual de mantenimiento es horario.
# La apertura requiere comprobar reintentos y configurar la frecuencia aprobada.
# Activar el worker persistente sólo cuando el servidor Node tenga vida continua.
OPERATION_OUTBOX_WORKER=false
CRON_SECRET=
# Respaldos cifrados y recuperación de cola offline. Generar claves independientes.
BACKUP_ENCRYPTION_KEY=
OFFLINE_QUEUE_RECOVERY_PUBLIC_KEY=
OFFLINE_QUEUE_RECOVERY_PRIVATE_KEY=
# No habilitar ensayo ni demo en producción.
OPERATIONAL_REHEARSAL=false
