PORT=3001
VITE_PORT=5173
HOST=127.0.0.1
NODE_ENV=development
DEMO_MODE=false
# Required to open the public API outside local development.
PUBLIC_SITE_APPROVED=false
# Local preview works only in development when HOST is a loopback address.
PUBLIC_SITE_PREVIEW=true
# Cambiar solo después de la validación legal documentada por el profesional del club.
CLUB_OPERATIONS_APPROVED=false
POSTGRES_PASSWORD=
DATABASE_URL=
JWT_SECRET=replace-with-at-least-32-random-characters
# Optional stable dedicated HMAC key for imported member IDs. If omitted, JWT_SECRET is used.
# Preserve this key across deployments; rotating it changes pseudonymous IDs.
DATA_IMPORT_PII_SECRET=
ALLOWED_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@tuclub.com
# Requerida al crear una base de datos nueva; mínimo 12 caracteres.
ADMIN_PASSWORD=
# Activar detrás de HTTPS en producción.
COOKIE_SECURE=false
# Pruebas: base PostgreSQL local dedicada, distinta de DATABASE_URL y con nombre bombo_ui_*.
# Los runners crean y eliminan esquemas temporales; nunca apuntar a un túnel hacia otra base.
# TEST_DATABASE_URL=postgresql://usuario:clave@127.0.0.1:5432/bombo_ui_pruebas
