generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum Role {
  owner
  admin
  responsible
  cashier
  viewer
}
model User {
  id String @id @default(cuid())
  name String
  email String @unique
  password String
  role Role
  color String @default("#789b84")
  products Product[]
  sales Sale[]
  items SaleItem[]
  movements Movement[] @relation("Actor")
  transfersFrom Movement[] @relation("FromOwner")
  transfersTo Movement[] @relation("ToOwner")
  expenses Expense[]
  recurring RecurringRule[]
  closures Closure[]
  cashEntries CashEntry[]
  cashPlans CashPlan[]
  historicalImportBatches HistoricalImportBatch[] @relation("ImportCreatedBy")
  committedHistoricalImportBatches HistoricalImportBatch[] @relation("ImportCommittedBy")
  decisionTasks DecisionTask[]
  monthlyReviews MonthlyReview[]
  sensitiveAccessAudits SensitiveAccessAudit[]
  historicalReconciliations HistoricalReconciliation[]
  decisionStockMappings DecisionStockMapping[]
  decisionSupplierRules DecisionSupplierRule[]
  decisionReplacementQuotes DecisionReplacementQuote[]
  decisionInboundOrders DecisionInboundOrder[]
  decisionCashSnapshots DecisionCashSnapshot[]
  decisionCashPlanEvents DecisionCashPlanEvent[]
  decisionInputAttestations DecisionInputAttestation[]
}
model Supplier {
  id String @id @default(cuid())
  name String
  key String @unique
  contactName String @default("")
  phone String @default("")
  email String @default("")
  notes String @default("")
  active Boolean @default(true)
  isDefault Boolean @default(false)
  createdAt DateTime @default(now())
  products Product[]
  @@index([active, name])
}
model Location {
  id String @id @default(cuid())
  name String
  key String @unique
  active Boolean @default(true)
  isDefault Boolean @default(false)
  createdAt DateTime @default(now())
  products Product[]
  decisionInboundOrders DecisionInboundOrder[]
  @@index([active, name])
}
model Product {
  id String @id @default(cuid())
  name String
  strain String
  type String
  unit String @default("g")
  lot String @unique
  supplier String @default("")
  supplierId String?
  supplierRef Supplier? @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  sourceSystem String?
  sourceId String?
  stock Int
  minimum Int
  cost Int
  price Int
  location String
  locationId String?
  locationRef Location? @relation(fields: [locationId], references: [id], onDelete: Restrict)
  ownerId String
  owner User @relation(fields: [ownerId], references: [id])
  expires String?
  createdAt DateTime @default(now())
  items SaleItem[]
  movements Movement[]
  decisionSupplierRules DecisionSupplierRule[]
  decisionReplacementQuotes DecisionReplacementQuote[]
  decisionInboundOrders DecisionInboundOrder[]
  @@index([ownerId])
  @@index([supplierId])
  @@index([locationId])
  @@index([name, id])
  @@index([ownerId, name, id])
  @@unique([sourceSystem, sourceId])
}
model Customer {
  id String @id @default(cuid())
  name String
  email String
  phone String
  notes String @default("")
  points Int @default(0)
  permitStatus String @default("unverified")
  permitValidUntil String?
  permitCheckedAt DateTime?
  sourceSystem String?
  sourceId String?
  createdAt DateTime @default(now())
  sales Sale[]
  @@unique([sourceSystem, sourceId])
  @@index([name, id])
}
model Sale {
  id String @id @default(cuid())
  customerId String
  customer Customer @relation(fields: [customerId], references: [id])
  userId String
  user User @relation(fields: [userId], references: [id])
  date String
  createdAt DateTime @default(now())
  subtotal Int
  discount Int
  total Int
  cost Int
  pointsEarned Int
  pointsUsed Int
  payment String
  requestId String @unique
  channel String @default("local")
  items SaleItem[]
  cashEntry CashEntry?
  @@index([date])
  @@index([customerId])
  @@index([createdAt, id])
  @@index([date, createdAt, id])
  @@index([customerId, createdAt, id])
}
model CashEntry {
  id String @id @default(cuid())
  date String
  account String
  category String
  amount Int
  description String
  sourceSystem String?
  sourceId String?
  saleId String? @unique
  sale Sale? @relation(fields: [saleId], references: [id])
  userId String
  user User @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  @@unique([sourceSystem, sourceId])
  @@index([date, account])
  @@index([date, createdAt, id])
  @@index([account, date])
}
model CashPlan {
  id String @id @default(cuid())
  date String
  scenario String
  account String
  category String
  amount Int
  description String
  userId String
  user User @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  @@index([date, scenario])
  @@index([scenario, date])
}
model SaleItem {
  id String @id @default(cuid())
  saleId String
  sale Sale @relation(fields: [saleId], references: [id])
  productId String
  product Product @relation(fields: [productId], references: [id])
  ownerId String
  owner User @relation(fields: [ownerId], references: [id])
  name String
  unit String @default("g")
  quantity Int
  price Int
  cost Int
  revenue Int
  @@index([ownerId])
  @@index([ownerId, saleId])
  @@index([saleId])
}
model Movement {
  id String @id @default(cuid())
  productId String
  product Product @relation(fields: [productId], references: [id])
  type String
  quantity Int
  beforeStock Int
  afterStock Int
  fromOwner String?
  from User? @relation("FromOwner",fields: [fromOwner], references: [id])
  toOwner String?
  to User? @relation("ToOwner",fields: [toOwner], references: [id])
  userId String
  user User @relation("Actor",fields: [userId], references: [id])
  note String
  createdAt DateTime @default(now())
  @@index([productId, createdAt])
  @@index([createdAt, id])
}
model Expense {
  id String @id @default(cuid())
  name String
  amount Int
  category String
  kind String
  ownerId String?
  owner User? @relation(fields: [ownerId], references: [id])
  date String
  recurrence String @default("none")
  ruleId String?
  rule RecurringRule? @relation(fields: [ruleId], references: [id])
  @@unique([ruleId, date])
  @@index([date, id])
  @@index([ownerId, date, id])
}
model RecurringRule {
  id String @id @default(cuid())
  name String
  amount Int
  category String
  ownerId String?
  owner User? @relation(fields: [ownerId], references: [id])
  recurrence String
  nextDate String
  expenses Expense[]
}
model Closure {
  id String @id @default(cuid())
  date String @unique
  expected Int
  counted Int
  difference Int
  userId String
  user User @relation(fields: [userId], references: [id])
  note String
  createdAt DateTime @default(now())
}
model Setting {
  id Int @id @default(1)
  value Json
}

// Public editorial content is intentionally independent of inventory and prices.
model ShowcaseItem {
  id String @id @default(cuid())
  slug String @unique
  title String
  category String
  description String @db.Text
  status String @default("draft")
  sortOrder Int @default(0)
  image ShowcaseImage?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, sortOrder, createdAt])
}

model ShowcaseImage {
  itemId String @id
  item ShowcaseItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  data Bytes
  mime String
  width Int
  height Int
  updatedAt DateTime @updatedAt
}

model PublicInquiry {
  id String @id @default(cuid())
  name String
  contact String
  interest String
  message String @db.Text
  source String
  status String @default("new")
  notes String @default("") @db.Text
  consentAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, createdAt])
}

model SiteChannels {
  id Int @id @default(1)
  whatsappPhone String @default("")
  instagramUrl String @default("")
  updatedAt DateTime @updatedAt
}

enum HistoricalImportStatus {
  ready
  rejected
  imported
  reconciled
}

enum DecisionTaskCadence {
  none
  weekly
  monthly
}

enum DecisionEvidenceState {
  demo
  missing
  imported
  reconciled
  estimated
  scenario
}

model HistoricalImportBatch {
  id String @id
  idempotencyKey String @unique
  kind String
  sourceSystem String
  fileHash String
  mappingVersion String
  cutoffDate DateTime @db.Date
  status HistoricalImportStatus
  mapping Json
  facts Json
  factsHash String
  rowCount Int
  acceptedCount Int
  rejectedCount Int
  errors Json
  conflicts Json
  insertedCount Int @default(0)
  skippedCount Int @default(0)
  createdByUserId String?
  createdByUser User? @relation("ImportCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  committedByUserId String?
  committedByUser User? @relation("ImportCommittedBy", fields: [committedByUserId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  importedAt DateTime?
  reconciliation HistoricalReconciliation?
  provenance HistoricalImportProvenance[]
  @@index([sourceSystem, createdAt])
  @@index([status, createdAt])
}

model HistoricalImportProvenance {
  id String @id
  batchId String
  batch HistoricalImportBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  factKind String
  sourceSystem String
  sourceId String
  factHash String
  disposition String
  recordedAt DateTime @default(now())
  @@unique([batchId, factKind, sourceSystem, sourceId])
  @@index([sourceSystem, factKind, sourceId])
  @@index([batchId, recordedAt])
}

model HistoricalDeliverySale {
  id String @id
  sourceSystem String
  sourceId String
  factHash String
  saleDate DateTime @db.Date
  totalCents BigInt
  discountCents BigInt @default(0)
  lines HistoricalDeliverySaleLine[]
  @@unique([sourceSystem, sourceId])
  @@index([saleDate])
}

model HistoricalDeliverySaleLine {
  id String @id
  sourceSystem String
  sourceId String
  factHash String
  saleId String
  sale HistoricalDeliverySale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  itemLabel String
  productSourceId String?
  quantityMilliunits BigInt
  quantityUnit String
  unitPriceCents BigInt?
  lineTotalCents BigInt
  @@unique([sourceSystem, sourceId])
  @@index([saleId])
  @@index([productSourceId])
}

model HistoricalPurchaseReceipt {
  id String @id
  sourceSystem String
  sourceId String
  factHash String
  receivedDate DateTime @db.Date
  orderDate DateTime? @db.Date
  supplierSourceId String?
  totalCents BigInt
  lines HistoricalPurchaseReceiptLine[]
  @@unique([sourceSystem, sourceId])
  @@index([receivedDate])
  @@index([supplierSourceId, receivedDate])
  @@index([supplierSourceId, orderDate])
}

model HistoricalPurchaseReceiptLine {
  id String @id
  sourceSystem String
  sourceId String
  factHash String
  receiptId String
  receipt HistoricalPurchaseReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  itemLabel String
  productSourceId String?
  quantityMilliunits BigInt
  quantityUnit String
  unitCostCents BigInt?
  lineTotalCents BigInt
  @@unique([sourceSystem, sourceId])
  @@index([receiptId])
  @@index([productSourceId])
}

model HistoricalStockObservation {
  id String @id
  sourceSystem String
  sourceId String
  factHash String
  observedDate DateTime @db.Date
  productSourceId String?
  itemLabel String
  locationSourceId String?
  quantityMilliunits BigInt
  quantityUnit String
  @@unique([sourceSystem, sourceId])
  @@index([observedDate, productSourceId])
  @@index([locationSourceId, observedDate])
}

model HistoricalStockout {
  id String @id
  sourceSystem String
  sourceId String
  factHash String
  stockoutDate DateTime @db.Date
  productSourceId String?
  itemLabel String
  locationSourceId String?
  lostQuantityMilliunits BigInt?
  quantityUnit String?
  @@unique([sourceSystem, sourceId])
  @@index([stockoutDate, productSourceId])
  @@index([locationSourceId, stockoutDate])
}

model HistoricalExpense {
  id String @id
  sourceSystem String
  sourceId String
  factHash String
  expenseDate DateTime @db.Date
  category String
  amountCents BigInt
  @@unique([sourceSystem, sourceId])
  @@index([expenseDate, category])
}

model HistoricalPromotion {
  id String @id
  sourceSystem String
  sourceId String
  factHash String
  label String
  startsOn DateTime @db.Date
  endsOn DateTime? @db.Date
  discountCents BigInt?
  @@unique([sourceSystem, sourceId])
  @@index([startsOn, endsOn])
}

model HistoricalCashReconciliation {
  id String @id
  sourceSystem String
  sourceId String
  factHash String
  reconciledDate DateTime @db.Date
  account String
  expectedCents BigInt
  countedCents BigInt
  varianceCents BigInt
  @@unique([sourceSystem, sourceId])
  @@index([reconciledDate, account])
}

model HistoricalCashMovement {
  id String @id
  sourceSystem String
  sourceId String
  factHash String
  movementDate DateTime @db.Date
  account String
  category String
  amountCents BigInt
  @@unique([sourceSystem, sourceId])
  @@index([movementDate, account])
  @@index([category, movementDate])
}

model HistoricalMember {
  id String @id
  sourceSystem String
  sourceId String
  factHash String
  memberKey String
  permitStatus String
  permitExpiryDate DateTime? @db.Date
  permitCheckedAt DateTime? @db.Date
  @@unique([sourceSystem, sourceId])
  @@unique([sourceSystem, memberKey])
}

model DecisionTask {
  id String @id @default(cuid())
  title String
  ownerId String?
  owner User? @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  dueDate DateTime @db.Date
  cadence DecisionTaskCadence @default(none)
  status String @default("todo")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, dueDate])
  @@index([ownerId, dueDate])
}

model MonthlyReview {
  id String @id @default(cuid())
  period String
  metric String
  actualCents BigInt?
  planCents BigInt?
  deviationCents BigInt?
  cause String @default("") @db.Text
  decision String @default("") @db.Text
  ownerId String?
  owner User? @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  followUpDate DateTime? @db.Date
  source String
  evidence DecisionEvidenceState
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([period])
  @@index([ownerId, period])
}

model HistoricalReconciliation {
  id String @id @default(cuid())
  batchId String @unique
  batch HistoricalImportBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  asOf DateTime @db.Date
  coverageFrom DateTime? @db.Date
  coverageThrough DateTime? @db.Date
  coverageComplete Boolean @default(false)
  reference String
  notes String @default("") @db.Text
  confirmedByUserId String
  confirmedByUser User @relation(fields: [confirmedByUserId], references: [id], onDelete: Restrict)
  confirmedAt DateTime @default(now())
  varianceCents BigInt?
  sourceRecordCount Int?
  sourceTotalCents BigInt?
  calculatedTotalCents BigInt?
  @@index([asOf])
}

model SensitiveAccessAudit {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  area String
  action String
  at DateTime @default(now())
  metadata Json?
  @@index([userId, at])
  @@index([area, at])
}

model DecisionStockMapping {
  id String @id
  status String
  sharedLocationIds Json @default("[]")
  localLocationIds Json @default("[]")
  deliveryLocationIds Json @default("[]")
  reference String
  confirmedByUserId String
  confirmedByUser User @relation(fields: [confirmedByUserId], references: [id], onDelete: Restrict)
  confirmedAt DateTime @default(now())
}

model DecisionSupplierRule {
  id String @id
  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  leadTimeDays Int
  minimumOrderQuantityMilliunits Int
  reviewPeriodDays Int
  sourceReference String
  confirmedByUserId String
  confirmedByUser User @relation(fields: [confirmedByUserId], references: [id], onDelete: Restrict)
  updatedAt DateTime @updatedAt
  @@index([productId, updatedAt])
}

model DecisionReplacementQuote {
  id String @id
  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  quotedOn DateTime @db.Date
  validUntil DateTime? @db.Date
  unitCostCentsPerUnit BigInt
  status String @default("active")
  sourceReference String
  enteredByUserId String
  enteredByUser User @relation(fields: [enteredByUserId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  @@index([productId, quotedOn])
}

model DecisionInboundOrder {
  id String @id
  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  locationId String?
  location Location? @relation(fields: [locationId], references: [id], onDelete: Restrict)
  quantityMilliunits Int
  arrivalDate DateTime @db.Date
  status String @default("pending")
  sourceReference String
  enteredByUserId String
  enteredByUser User @relation(fields: [enteredByUserId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  @@index([productId, arrivalDate])
}

model DecisionCashSnapshot {
  id String @id
  asOf DateTime @db.Date
  floorCents BigInt
  sourceReference String
  complete Boolean @default(false)
  reconciledByUserId String
  reconciledByUser User @relation(fields: [reconciledByUserId], references: [id], onDelete: Restrict)
  reconciledAt DateTime @default(now())
  accounts DecisionCashSnapshotAccount[]
  @@index([asOf, reconciledAt])
}

model DecisionCashSnapshotAccount {
  snapshotId String
  snapshot DecisionCashSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  account String
  amountCents BigInt
  @@id([snapshotId, account])
}

model DecisionCashPlanEvent {
  id String @id
  scenario String
  date DateTime @db.Date
  account String
  category String
  amountCents BigInt
  status String @default("active")
  sourceReference String
  enteredByUserId String
  enteredByUser User @relation(fields: [enteredByUserId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  @@index([scenario, date])
}

model DecisionInputAttestation {
  id String @id
  domain String
  scenario String?
  fromDate DateTime @db.Date
  throughDate DateTime @db.Date
  complete Boolean @default(false)
  sourceReference String
  confirmedByUserId String
  confirmedByUser User @relation(fields: [confirmedByUserId], references: [id], onDelete: Restrict)
  confirmedAt DateTime @default(now())
  @@index([domain, scenario, fromDate, throughDate])
}
