generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum Role {
  owner
  admin
  responsible
  cashier
  viewer
}
model User {
  id String @id @default(cuid())
  name String
  email String? @unique
  username String? @unique
  password String
  role Role
  color String @default("#789b84")
  active Boolean @default(true)
  authorizationEpoch Int @default(1)
  products Product[]
  sales Sale[]
  items SaleItem[]
  movements Movement[] @relation("Actor")
  transfersFrom Movement[] @relation("FromOwner")
  transfersTo Movement[] @relation("ToOwner")
  expenses Expense[]
  recurring RecurringRule[]
  closures Closure[]
  cashEntries CashEntry[]
  cashPlans CashPlan[]
  historicalImportBatches HistoricalImportBatch[] @relation("ImportCreatedBy")
  committedHistoricalImportBatches HistoricalImportBatch[] @relation("ImportCommittedBy")
  decisionTasks DecisionTask[]
  monthlyReviews MonthlyReview[]
  sensitiveAccessAudits SensitiveAccessAudit[]
  historicalReconciliations HistoricalReconciliation[]
  decisionStockMappings DecisionStockMapping[]
  decisionSupplierRules DecisionSupplierRule[]
  decisionReplacementQuotes DecisionReplacementQuote[]
  decisionInboundOrders DecisionInboundOrder[]
  decisionCashSnapshots DecisionCashSnapshot[]
  decisionCashPlanEvents DecisionCashPlanEvent[]
  decisionInputAttestations DecisionInputAttestation[]
}
// A reserved seat is not an active account. Email and an expiring setup link
// are required before it can become a User.
model TeamSeat {
  id String @id @default(cuid())
  name String
  role Role
  email String? @unique
  tokenHash String? @unique
  expiresAt DateTime?
  activatedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Supplier {
  id String @id @default(cuid())
  name String
  key String @unique
  contactName String @default("")
  phone String @default("")
  email String @default("")
  notes String @default("")
  active Boolean @default(true)
  isDefault Boolean @default(false)
  createdAt DateTime @default(now())
  products Product[]
  @@index([active, name])
}
model Location {
  id String @id @default(cuid())
  name String
  key String @unique
  active Boolean @default(true)
  isDefault Boolean @default(false)
  createdAt DateTime @default(now())
  products Product[]
  decisionInboundOrders DecisionInboundOrder[]
  @@index([active, name])
}
model ProductCategory {
  id String @id @default(cuid())
  name String
  key String @unique
  minVarieties Int @default(0)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  products Product[]
  @@index([active, name])
}
model Product {
  id String @id @default(cuid())
  name String
  strain String
  type String
  unit String @default("g")
  lot String @unique
  supplier String @default("")
  supplierId String?
  supplierRef Supplier? @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  sourceSystem String?
  sourceId String?
  stock Int
  minimum Int
  cost Int
  price Int
  location String
  locationId String?
  locationRef Location? @relation(fields: [locationId], references: [id], onDelete: Restrict)
  categoryId String?
  categoryRef ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  ownerId String
  owner User @relation(fields: [ownerId], references: [id])
  expires String?
  createdAt DateTime @default(now())
  items SaleItem[]
  movements Movement[]
  decisionSupplierRules DecisionSupplierRule[]
  decisionReplacementQuotes DecisionReplacementQuote[]
  decisionInboundOrders DecisionInboundOrder[]
  @@index([ownerId])
  @@index([supplierId])
  @@index([locationId])
  @@index([categoryId])
  @@index([name, id])
  @@index([ownerId, name, id])
  @@unique([sourceSystem, sourceId])
}
model Customer {
  id String @id @default(cuid())
  name String
  email String
  phone String
  notes String @default("")
  points Int @default(0)
  permitStatus String @default("unverified")
  permitValidUntil String?
  permitCheckedAt DateTime?
  sourceSystem String?
  sourceId String?
  createdAt DateTime @default(now())
  sales Sale[]
  @@unique([sourceSystem, sourceId])
  @@index([name, id])
}
model Sale {
  id String @id @default(cuid())
  customerId String
  customer Customer @relation(fields: [customerId], references: [id])
  userId String
  user User @relation(fields: [userId], references: [id])
  date String
  createdAt DateTime @default(now())
  subtotal Int
  discount Int
  total Int
  cost Int
  pointsEarned Int
  pointsUsed Int
  payment String
  // Only for payment "mixed": [{ method: "cash", amount }, { method: "transfer" | "card", amount }] in cents.
  paymentSplit Json?
  requestId String @unique
  channel String @default("local")
  items SaleItem[]
  cashEntries CashEntry[]
  @@index([date])
  @@index([customerId])
  @@index([createdAt, id])
  @@index([date, createdAt, id])
  @@index([customerId, createdAt, id])
}
model CashEntry {
  id String @id @default(cuid())
  date String
  account String
  category String
  amount Int
  description String
  sourceSystem String?
  sourceId String?
  saleId String?
  sale Sale? @relation(fields: [saleId], references: [id])
  userId String
  user User @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  @@unique([sourceSystem, sourceId])
  @@unique([saleId, account])
  @@index([date, account])
  @@index([date, createdAt, id])
  @@index([account, date])
}
model CashPlan {
  id String @id @default(cuid())
  date String
  scenario String
  account String
  category String
  amount Int
  description String
  userId String
  user User @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  @@index([date, scenario])
  @@index([scenario, date])
}
model SaleItem {
  id String @id @default(cuid())
  saleId String
  sale Sale @relation(fields: [saleId], references: [id])
  productId String
  product Product @relation(fields: [productId], references: [id])
  ownerId String
  owner User @relation(fields: [ownerId], references: [id])
  name String
  unit String @default("g")
  quantity Int
  price Int
  cost Int
  revenue Int
  @@index([ownerId])
  @@index([ownerId, saleId])
  @@index([saleId])
}
model Movement {
  id String @id @default(cuid())
  productId String
  product Product @relation(fields: [productId], references: [id])
  type String
  quantity Int
  beforeStock Int
  afterStock Int
  fromOwner String?
  from User? @relation("FromOwner",fields: [fromOwner], references: [id])
  toOwner String?
  to User? @relation("ToOwner",fields: [toOwner], references: [id])
  userId String
  user User @relation("Actor",fields: [userId], references: [id])
  note String
  createdAt DateTime @default(now())
  @@index([productId, createdAt])
  @@index([createdAt, id])
}
model Expense {
  id String @id @default(cuid())
  name String
  amount Int
  category String
  kind String
  ownerId String?
  owner User? @relation(fields: [ownerId], references: [id])
  date String
  recurrence String @default("none")
  ruleId String?
  rule RecurringRule? @relation(fields: [ruleId], references: [id])
  @@unique([ruleId, date])
  @@index([date, id])
  @@index([ownerId, date, id])
}
model RecurringRule {
  id String @id @default(cuid())
  name String
  amount Int
  category String
  ownerId String?
  owner User? @relation(fields: [ownerId], references: [id])
  recurrence String
  nextDate String
  expenses Expense[]
}
model Closure {
  id String @id @default(cuid())
  date String @unique
  expected Int
  counted Int
  difference Int
  userId String
  user User @relation(fields: [userId], references: [id])
  note String
  createdAt DateTime @default(now())
}
model Setting {
  id Int @id @default(1)
  value Json
}

// Public editorial content is intentionally independent of inventory and prices.
model ShowcaseItem {
  id String @id @default(cuid())
  slug String @unique
  title String
  category String
  description String @db.Text
  status String @default("draft")
  sortOrder Int @default(0)
  image ShowcaseImage?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, sortOrder, createdAt])
}

model ShowcaseImage {
  itemId String @id
  item ShowcaseItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  data Bytes
  mime String
  width Int
  height Int
  updatedAt DateTime @updatedAt
}

model PublicInquiry {
  id String @id @default(cuid())
  name String
  contact String
  interest String
  message String @db.Text
  source String
  status String @default("new")
  notes String @default("") @db.Text
  consentAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, createdAt])
}

model SiteChannels {
  id Int @id @default(1)
  whatsappPhone String @default("")
  instagramUrl String @default("")
  updatedAt DateTime @updatedAt
}

enum HistoricalImportStatus {
  ready
  rejected
  imported
  reconciled
}

enum DecisionTaskCadence {
  none
  weekly
  monthly
}

enum DecisionEvidenceState {
  demo
  missing
  imported
  reconciled
  estimated
  scenario
}

model HistoricalImportBatch {
  id String @id
  idempotencyKey String @unique
  kind String
  sourceSystem String
  fileHash String
  mappingVersion String
  cutoffDate DateTime @db.Date
  status HistoricalImportStatus
  mapping Json
  facts Json
  factsHash String
  rowCount Int
  acceptedCount Int
  rejectedCount Int
  errors Json
  conflicts Json
  insertedCount Int @default(0)
  skippedCount Int @default(0)
  createdByUserId String?
  createdByUser User? @relation("ImportCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  committedByUserId String?
  committedByUser User? @relation("ImportCommittedBy", fields: [committedByUserId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  importedAt DateTime?
  reconciliation HistoricalReconciliation?
  provenance HistoricalImportProvenance[]
  @@index([sourceSystem, createdAt])
  @@index([status, createdAt])
}

model HistoricalImportProvenance {
  id String @id
  batchId String
  batch HistoricalImportBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  factKind String
  sourceSystem String
  sourceId String
  factHash String
  disposition String
  recordedAt DateTime @default(now())
  @@unique([batchId, factKind, sourceSystem, sourceId])
  @@index([sourceSystem, factKind, sourceId])
  @@index([batchId, recordedAt])
}

model HistoricalDeliverySale {
  id String @id
  sourceSystem String
  sourceId String
  factHash String
  saleDate DateTime @db.Date
  totalCents BigInt
  discountCents BigInt @default(0)
  lines HistoricalDeliverySaleLine[]
  @@unique([sourceSystem, sourceId])
  @@index([saleDate])
}

model HistoricalDeliverySaleLine {
  id String @id
  sourceSystem String
  sourceId String
  factHash String
  saleId String
  sale HistoricalDeliverySale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  itemLabel String
  productSourceId String?
  quantityMilliunits BigInt
  quantityUnit String
  unitPriceCents BigInt?
  lineTotalCents BigInt
  @@unique([sourceSystem, sourceId])
  @@index([saleId])
  @@index([productSourceId])
}

model HistoricalPurchaseReceipt {
  id String @id
  sourceSystem String
  sourceId String
  factHash String
  receivedDate DateTime @db.Date
  orderDate DateTime? @db.Date
  supplierSourceId String?
  totalCents BigInt
  lines HistoricalPurchaseReceiptLine[]
  @@unique([sourceSystem, sourceId])
  @@index([receivedDate])
  @@index([supplierSourceId, receivedDate])
  @@index([supplierSourceId, orderDate])
}

model HistoricalPurchaseReceiptLine {
  id String @id
  sourceSystem String
  sourceId String
  factHash String
  receiptId String
  receipt HistoricalPurchaseReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  itemLabel String
  productSourceId String?
  quantityMilliunits BigInt
  quantityUnit String
  unitCostCents BigInt?
  lineTotalCents BigInt
  @@unique([sourceSystem, sourceId])
  @@index([receiptId])
  @@index([productSourceId])
}

model HistoricalStockObservation {
  id String @id
  sourceSystem String
  sourceId String
  factHash String
  observedDate DateTime @db.Date
  productSourceId String?
  itemLabel String
  locationSourceId String?
  quantityMilliunits BigInt
  quantityUnit String
  @@unique([sourceSystem, sourceId])
  @@index([observedDate, productSourceId])
  @@index([locationSourceId, observedDate])
}

model HistoricalStockout {
  id String @id
  sourceSystem String
  sourceId String
  factHash String
  stockoutDate DateTime @db.Date
  productSourceId String?
  itemLabel String
  locationSourceId String?
  lostQuantityMilliunits BigInt?
  quantityUnit String?
  @@unique([sourceSystem, sourceId])
  @@index([stockoutDate, productSourceId])
  @@index([locationSourceId, stockoutDate])
}

model HistoricalExpense {
  id String @id
  sourceSystem String
  sourceId String
  factHash String
  expenseDate DateTime @db.Date
  category String
  amountCents BigInt
  @@unique([sourceSystem, sourceId])
  @@index([expenseDate, category])
}

model HistoricalPromotion {
  id String @id
  sourceSystem String
  sourceId String
  factHash String
  label String
  startsOn DateTime @db.Date
  endsOn DateTime? @db.Date
  discountCents BigInt?
  @@unique([sourceSystem, sourceId])
  @@index([startsOn, endsOn])
}

model HistoricalCashReconciliation {
  id String @id
  sourceSystem String
  sourceId String
  factHash String
  reconciledDate DateTime @db.Date
  account String
  expectedCents BigInt
  countedCents BigInt
  varianceCents BigInt
  @@unique([sourceSystem, sourceId])
  @@index([reconciledDate, account])
}

model HistoricalCashMovement {
  id String @id
  sourceSystem String
  sourceId String
  factHash String
  movementDate DateTime @db.Date
  account String
  category String
  amountCents BigInt
  @@unique([sourceSystem, sourceId])
  @@index([movementDate, account])
  @@index([category, movementDate])
}

model HistoricalMember {
  id String @id
  sourceSystem String
  sourceId String
  factHash String
  memberKey String
  permitStatus String
  permitExpiryDate DateTime? @db.Date
  permitCheckedAt DateTime? @db.Date
  @@unique([sourceSystem, sourceId])
  @@unique([sourceSystem, memberKey])
}

model DecisionTask {
  id String @id @default(cuid())
  title String
  ownerId String?
  owner User? @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  dueDate DateTime @db.Date
  cadence DecisionTaskCadence @default(none)
  status String @default("todo")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, dueDate])
  @@index([ownerId, dueDate])
}

model MonthlyReview {
  id String @id @default(cuid())
  period String
  metric String
  actualCents BigInt?
  planCents BigInt?
  deviationCents BigInt?
  cause String @default("") @db.Text
  decision String @default("") @db.Text
  ownerId String?
  owner User? @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  followUpDate DateTime? @db.Date
  source String
  evidence DecisionEvidenceState
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([period])
  @@index([ownerId, period])
}

model HistoricalReconciliation {
  id String @id @default(cuid())
  batchId String @unique
  batch HistoricalImportBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  asOf DateTime @db.Date
  coverageFrom DateTime? @db.Date
  coverageThrough DateTime? @db.Date
  coverageComplete Boolean @default(false)
  reference String
  notes String @default("") @db.Text
  confirmedByUserId String
  confirmedByUser User @relation(fields: [confirmedByUserId], references: [id], onDelete: Restrict)
  confirmedAt DateTime @default(now())
  varianceCents BigInt?
  sourceRecordCount Int?
  sourceTotalCents BigInt?
  calculatedTotalCents BigInt?
  @@index([asOf])
}

model SensitiveAccessAudit {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  area String
  action String
  at DateTime @default(now())
  metadata Json?
  @@index([userId, at])
  @@index([area, at])
}

model DecisionStockMapping {
  id String @id
  status String
  sharedLocationIds Json @default("[]")
  localLocationIds Json @default("[]")
  deliveryLocationIds Json @default("[]")
  reference String
  confirmedByUserId String
  confirmedByUser User @relation(fields: [confirmedByUserId], references: [id], onDelete: Restrict)
  confirmedAt DateTime @default(now())
}

model DecisionSupplierRule {
  id String @id
  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  leadTimeDays Int
  minimumOrderQuantityMilliunits Int
  reviewPeriodDays Int
  sourceReference String
  confirmedByUserId String
  confirmedByUser User @relation(fields: [confirmedByUserId], references: [id], onDelete: Restrict)
  updatedAt DateTime @updatedAt
  @@index([productId, updatedAt])
}

model DecisionReplacementQuote {
  id String @id
  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  quotedOn DateTime @db.Date
  validUntil DateTime? @db.Date
  unitCostCentsPerUnit BigInt
  status String @default("active")
  sourceReference String
  enteredByUserId String
  enteredByUser User @relation(fields: [enteredByUserId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  @@index([productId, quotedOn])
}

model DecisionInboundOrder {
  id String @id
  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  locationId String?
  location Location? @relation(fields: [locationId], references: [id], onDelete: Restrict)
  quantityMilliunits Int
  arrivalDate DateTime @db.Date
  status String @default("pending")
  sourceReference String
  enteredByUserId String
  enteredByUser User @relation(fields: [enteredByUserId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  @@index([productId, arrivalDate])
}

model DecisionCashSnapshot {
  id String @id
  asOf DateTime @db.Date
  floorCents BigInt
  sourceReference String
  complete Boolean @default(false)
  reconciledByUserId String
  reconciledByUser User @relation(fields: [reconciledByUserId], references: [id], onDelete: Restrict)
  reconciledAt DateTime @default(now())
  accounts DecisionCashSnapshotAccount[]
  @@index([asOf, reconciledAt])
}

model DecisionCashSnapshotAccount {
  snapshotId String
  snapshot DecisionCashSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  account String
  amountCents BigInt
  @@id([snapshotId, account])
}

model DecisionCashPlanEvent {
  id String @id
  scenario String
  date DateTime @db.Date
  account String
  category String
  amountCents BigInt
  status String @default("active")
  sourceReference String
  enteredByUserId String
  enteredByUser User @relation(fields: [enteredByUserId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  @@index([scenario, date])
}

model DecisionInputAttestation {
  id String @id
  domain String
  scenario String?
  fromDate DateTime @db.Date
  throughDate DateTime @db.Date
  complete Boolean @default(false)
  sourceReference String
  confirmedByUserId String
  confirmedByUser User @relation(fields: [confirmedByUserId], references: [id], onDelete: Restrict)
  confirmedAt DateTime @default(now())
  @@index([domain, scenario, fromDate, throughDate])
}

// Canonical operations. Existing tables remain historical compatibility projections.
model OperationAuthority {
  id String @id @default("operations")
  mode String @default("shadow")
  cutoverProfile String @default("legacy")
  captureManifestId String?
  captureManifest AppSheetCaptureManifest? @relation("ActiveAuthorityCapture", fields: [captureManifestId], references: [captureId], onDelete: Restrict)
  epoch Int @default(1)
  firstRealWriteAt DateTime?
  approvedBy String?
  evidence Json?
  updatedAt DateTime @updatedAt
}
model OperationObject {
  id String @id
  kind String
  version Int @default(0)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  appSheetPreorderDraft AppSheetPreorderDraft?
  @@index([kind, updatedAt])
}
model CommandReceipt {
  requestId String @id @db.Uuid
  actorId String
  targetId String
  command String
  bodyHash String
  response Json
  resultingVersion Int
  authorityEpoch Int
  occurredAt DateTime
  committedAt DateTime @default(now())
  @@index([actorId, committedAt])
  @@index([targetId, committedAt])
}
model OperationOutbox {
  id String @id @default(uuid()) @db.Uuid
  requestId String @db.Uuid
  topic String
  payload Json
  status String @default("pending")
  attempts Int @default(0)
  createdAt DateTime @default(now())
  processedAt DateTime?
  @@index([status, createdAt])
}
model OperationAudit {
  id String @id @default(uuid()) @db.Uuid
  actorId String
  action String
  objectId String
  requestId String?
  details Json
  createdAt DateTime @default(now())
  @@index([objectId, createdAt])
}
model OperationAccess {
  userId String @id
  profile String
  capabilities Json
  scope Json @default("{}")
  enabled Boolean @default(true)
  updatedAt DateTime @updatedAt
}
model OperationSession {
  id String @id @default(uuid()) @db.Uuid
  userId String
  authorizationEpoch Int
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId, expiresAt])
}
model OperationDevice {
  id String @id @default(uuid()) @db.Uuid
  userId String
  name String
  storageCertified Boolean @default(false)
  storageCertifiedAt DateTime?
  evidence Json?
  revokedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId])
}
model OfflineLease {
  id String @id @default(uuid()) @db.Uuid
  userId String
  deviceId String @db.Uuid
  sessionId String @db.Uuid
  authorizationEpoch Int
  authorityEpoch Int
  assignments Json
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId, expiresAt])
}
model OfflineBackup {
  id String @id @default(uuid()) @db.Uuid
  userId String
  deviceId String @db.Uuid
  leaseId String @db.Uuid
  sha256 String
  package Json
  recoveredBy String?
  createdAt DateTime @default(now())
  @@unique([userId, deviceId, sha256])
}
model OfflineQuarantine {
  requestId String @id @db.Uuid
  userId String
  deviceId String @db.Uuid
  leaseId String @db.Uuid
  targetId String
  envelope Json
  reason String
  resolvedBy String?
  resolutionRequestId String?
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
}
model OfflineRecovery {
  id String @id @default(uuid()) @db.Uuid
  backupId String @db.Uuid
  ownerId String
  reviewerId String?
  reason String
  status String @default("requested")
  createdAt DateTime @default(now())
  approvedAt DateTime?
}
model OperationMember {
  id String @id
  legacyCustomerId String? @unique
  name String
  email String @default("")
  phone String @default("")
  address Json
  preferences Json
  sourceSystem String?
  sourceId String?
  createdAt DateTime @default(now())
  appSheetPreorderDrafts AppSheetPreorderDraft[]
  @@unique([sourceSystem, sourceId])
  @@index([name, id])
}
model AppSheetPreorderDraft {
  id String @id
  operationObject OperationObject @relation(fields: [id], references: [id], onDelete: Restrict)
  memberId String
  member OperationMember @relation(fields: [memberId], references: [id], onDelete: Restrict)
  schemaVersion Int
  snapshotHash String
  payload Json
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([memberId, updatedAt, id])
}
model MemberClinicalRecord {
  memberId String @id
  provenance Json
  encryptedObjectKey String?
  verification String @default("unverified")
  reviewedBy String?
  reviewedAt DateTime?
}
model MemberPermission {
  id String @id @default(uuid()) @db.Uuid
  memberId String
  kind String
  status String @default("unverified")
  validFrom String?
  validUntil String?
  evidenceDocumentId String?
  reviewerId String?
  reviewedAt DateTime?
  @@index([memberId, kind, status])
}
model OperationDocument {
  id String @id @default(uuid()) @db.Uuid
  memberId String?
  orderId String?
  deliveryId String?
  kind String
  sensitivity String
  state String @default("referenced")
  objectKey String?
  checksum String?
  objectVersion String?
