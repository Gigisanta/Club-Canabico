generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum Role {
  owner
  admin
  responsible
  cashier
  viewer
}
model User {
  id String @id @default(cuid())
  name String
  email String @unique
  password String
  role Role
  color String @default("#789b84")
  products Product[]
  sales Sale[]
  items SaleItem[]
  movements Movement[] @relation("Actor")
  transfersFrom Movement[] @relation("FromOwner")
  transfersTo Movement[] @relation("ToOwner")
  expenses Expense[]
  recurring RecurringRule[]
  closures Closure[]
  cashEntries CashEntry[]
  cashPlans CashPlan[]
}
model Supplier {
  id String @id @default(cuid())
  name String
  key String @unique
  contactName String @default("")
  phone String @default("")
  email String @default("")
  notes String @default("")
  active Boolean @default(true)
  isDefault Boolean @default(false)
  createdAt DateTime @default(now())
  products Product[]
  @@index([active, name])
}
model Location {
  id String @id @default(cuid())
  name String
  key String @unique
  active Boolean @default(true)
  isDefault Boolean @default(false)
  createdAt DateTime @default(now())
  products Product[]
  @@index([active, name])
}
model Product {
  id String @id @default(cuid())
  name String
  strain String
  type String
  unit String @default("g")
  lot String @unique
  supplier String @default("")
  supplierId String?
  supplierRef Supplier? @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  sourceSystem String?
  sourceId String?
  stock Int
  minimum Int
  cost Int
  price Int
  location String
  locationId String?
  locationRef Location? @relation(fields: [locationId], references: [id], onDelete: Restrict)
  ownerId String
  owner User @relation(fields: [ownerId], references: [id])
  expires String?
  createdAt DateTime @default(now())
  items SaleItem[]
  movements Movement[]
  @@index([ownerId])
  @@index([supplierId])
  @@index([locationId])
  @@index([name, id])
  @@index([ownerId, name, id])
  @@unique([sourceSystem, sourceId])
}
model Customer {
  id String @id @default(cuid())
  name String
  email String
  phone String
  notes String @default("")
  points Int @default(0)
  permitStatus String @default("unverified")
  permitValidUntil String?
  permitCheckedAt DateTime?
  sourceSystem String?
  sourceId String?
  createdAt DateTime @default(now())
  sales Sale[]
  @@unique([sourceSystem, sourceId])
  @@index([name, id])
}
model Sale {
  id String @id @default(cuid())
  customerId String
  customer Customer @relation(fields: [customerId], references: [id])
  userId String
  user User @relation(fields: [userId], references: [id])
  date String
  createdAt DateTime @default(now())
  subtotal Int
  discount Int
  total Int
  cost Int
  pointsEarned Int
  pointsUsed Int
  payment String
  requestId String @unique
  channel String @default("local")
  items SaleItem[]
  cashEntry CashEntry?
  @@index([date])
  @@index([customerId])
  @@index([createdAt, id])
  @@index([date, createdAt, id])
  @@index([customerId, createdAt, id])
}
model CashEntry {
  id String @id @default(cuid())
  date String
  account String
  category String
  amount Int
  description String
  sourceSystem String?
  sourceId String?
  saleId String? @unique
  sale Sale? @relation(fields: [saleId], references: [id])
  userId String
  user User @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  @@unique([sourceSystem, sourceId])
  @@index([date, account])
  @@index([date, createdAt, id])
  @@index([account, date])
}
model CashPlan {
  id String @id @default(cuid())
  date String
  scenario String
  account String
  category String
  amount Int
  description String
  userId String
  user User @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  @@index([date, scenario])
  @@index([scenario, date])
}
model SaleItem {
  id String @id @default(cuid())
  saleId String
  sale Sale @relation(fields: [saleId], references: [id])
  productId String
  product Product @relation(fields: [productId], references: [id])
  ownerId String
  owner User @relation(fields: [ownerId], references: [id])
  name String
  unit String @default("g")
  quantity Int
  price Int
  cost Int
  revenue Int
  @@index([ownerId])
  @@index([ownerId, saleId])
  @@index([saleId])
}
model Movement {
  id String @id @default(cuid())
  productId String
  product Product @relation(fields: [productId], references: [id])
  type String
  quantity Int
  beforeStock Int
  afterStock Int
  fromOwner String?
  from User? @relation("FromOwner",fields: [fromOwner], references: [id])
  toOwner String?
  to User? @relation("ToOwner",fields: [toOwner], references: [id])
  userId String
  user User @relation("Actor",fields: [userId], references: [id])
  note String
  createdAt DateTime @default(now())
  @@index([productId, createdAt])
  @@index([createdAt, id])
}
model Expense {
  id String @id @default(cuid())
  name String
  amount Int
  category String
  kind String
  ownerId String?
  owner User? @relation(fields: [ownerId], references: [id])
  date String
  recurrence String @default("none")
  ruleId String?
  rule RecurringRule? @relation(fields: [ruleId], references: [id])
  @@unique([ruleId, date])
  @@index([date, id])
  @@index([ownerId, date, id])
}
model RecurringRule {
  id String @id @default(cuid())
  name String
  amount Int
  category String
  ownerId String?
  owner User? @relation(fields: [ownerId], references: [id])
  recurrence String
  nextDate String
  expenses Expense[]
}
model Closure {
  id String @id @default(cuid())
  date String @unique
  expected Int
  counted Int
  difference Int
  userId String
  user User @relation(fields: [userId], references: [id])
  note String
  createdAt DateTime @default(now())
}
model Setting {
  id Int @id @default(1)
  value Json
}
