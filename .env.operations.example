# Copy to a private, ignored environment file. Use different resources for rehearsal and production.
NODE_ENV=production
DEMO_MODE=false
OPERATIONAL_REHEARSAL=false
HOST=0.0.0.0
PORT=3001
DATABASE_URL=
JWT_SECRET=
ALLOWED_ORIGIN=
COOKIE_SECURE=true
# Remains false until independent opening and cutover gates are approved.
CLUB_OPERATIONS_APPROVED=false
PUBLIC_SITE_APPROVED=false
PRIVATE_S3_BUCKET=
PRIVATE_S3_REGION=
PRIVATE_S3_ENDPOINT=
PRIVATE_S3_PATH_STYLE=false
# Use a workload identity / AWS provider chain for S3. No public ACLs.
# Optional queue-only RSA escrow; these values do not recover clinical documents.
OFFLINE_QUEUE_RECOVERY_PUBLIC_KEY=
OFFLINE_QUEUE_RECOVERY_PRIVATE_KEY=
# Supply separately to the backup operator. Never include in a backup package.
BACKUP_ENCRYPTION_KEY=
PG_BIN=
# Only for an isolated restore rehearsal; must be absolute, empty, and separate from normal storage.
RESTORE_PRIVATE_OBJECT_ROOT=
